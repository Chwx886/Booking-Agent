# Copy this to .env and fill in YOUR values. Never commit a real .env.
# No real secrets are in this file.

# --- Twilio (https://www.twilio.com/console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+61800000000

# --- OpenAI (PAID — only used when ZERO_COST_MODE=0) ---
# Leave blank in $0 mode. No OpenAI key is required for the $0 test.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EXTRACT_MODEL=gpt-4o-mini

# --- $0 mode (default ON) ---
# ZERO_COST_MODE=1: local faster-whisper + local Ollama (or rule-based
# fallback). No paid API is called. Set to 0 to use OpenAI instead.
ZERO_COST_MODE=1
# Local Whisper model: tiny (fastest, CPU) or base (more accurate).
LOCAL_WHISPER_MODEL=tiny
# Local Ollama (optional): http://localhost:11434 — if reachable, extraction
# uses OLLAMA_MODEL; otherwise the rule-based extractor is used and logged.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# --- Owner (the restaurant owner who receives the SMS booking summary) ---
# E.164 format, e.g. +61400000000 — the owner's own mobile.
# (OWNER_WHATSAPP_NUMBER is still accepted as a fallback for old .env files.)
OWNER_SMS_NUMBER=+61400000000
OWNER_PHONE=+61400000000

# --- SMS summary sender ---
# The business's 08 number in E.164 (+61 8 7562 7188). Must be an
# SMS-capable number in your Twilio account (check Capabilities in the Console).
SMS_FROM_NUMBER=+61875627188

# --- Google Calendar (optional, disabled if left blank) ---
GOOGLE_CREDENTIALS_PATH=
GOOGLE_CALENDAR_ID=primary

# --- Local test only ---
# MOCK_MODE=1 makes extraction use the deterministic test extractor and
# skips all paid API calls. Used by test_pipeline.py.
MOCK_MODE=0

# Public URL of this app (ngrok URL for local testing), used in Twilio webhooks.
BASE_URL=
